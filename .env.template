# ─── SLP Portal — Environment Variables Template ─────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# ── JWT Secret (REQUIRED in production) ──────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=change-me-to-a-random-64-char-string

# ── Admin credentials (REQUIRED — used for initial seed only) ────────────────
ADMIN_EMAIL=admin@slpsystems.ca
ADMIN_PASSWORD=change-me-strong-password   # Min 8 chars, uppercase + digit + special

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL the browser uses to reach the .NET backend
NEXT_PUBLIC_API_URL=http://localhost:5062
# In production (when behind nginx): NEXT_PUBLIC_API_URL=https://yourdomain.com
# Server-side fetch URL — used by Next.js page.tsx code running inside the
# frontend container. NEXT_PUBLIC_* is inlined at build time and would bake in
# a host-only URL the container cannot reach; INTERNAL_API_URL stays runtime-
# readable. Override only if you rename the backend service in docker-compose.
INTERNAL_API_URL=http://backend:5070

# Public site URL (used for Open Graph / SEO meta tags)
NEXT_PUBLIC_SITE_URL=https://slpsystems.ca

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── SMTP (email sending) ─────────────────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-sendgrid-api-key

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT=100     # requests per minute per IP

# ── Local AI (Ollama) — powers the on-site "SLP Assistant" chat ──────────────
# The frontend's /api/ai/* routes stream from a local Ollama daemon (no cloud,
# no API keys, $0). On the host, Ollama listens on 127.0.0.1:11434. Inside the
# frontend container use host.docker.internal so it can reach the host daemon.
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:latest          # any installed chat model (ollama pull ...)
OLLAMA_KEEP_ALIVE=30m                # keep model resident to avoid cold starts
# Agentic gateway (FastAPI, agentic-ollama-platform/serve.sh). The portal's
# /api/ai/agent route submits goals here; Ollama plans them and a cron worker
# executes locally. Host process on :8091; container reaches it via host.docker.internal.
AGENT_API_URL=http://host.docker.internal:8091

# ── Local AI portfolio / router ──────────────────────────────────────────────
AI_MODE=HYBRID                       # HYBRID (local-first, cloud for hard tasks) | LOCAL_ONLY | CLOUD_PREFERRED
OLL_FAST_MODEL=llama3.1:8b           # kept resident for instant interactive replies
# Kimi K3 (Moonshot) — preferred CLOUD for code/long-doc when set (else fully local).
KIMI_API_KEY=
KIMI_API_BASE=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2-0711-preview
# Worker reliability (durable queue controls)
WORKER_MAX_ATTEMPTS=2                # retries before dead-letter
WORKER_LEASE_SECONDS=90              # lease before a crashed task is requeued
WORKER_DEADLINE_SECONDS=600          # per-task overall deadline
WORKER_POLL_SECONDS=5                # continuous-worker poll interval (worker.py --loop)
# Tracking → GitHub (optional): versioned export of the audit tables
TRACKING_GIT_REMOTE=                 # e.g. https://<token>@github.com/you/ollama-tracking.git
# TRACKING_REPO_DIR defaults to agentic-ollama-platform/data/tracking-repo

# ── GitHub Actions required secrets ──────────────────────────────────────────
# Set these in GitHub → Settings → Secrets and Variables → Actions:
#
# DEPLOY_HOST          = your server IP or hostname
# DEPLOY_USER          = SSH username (e.g. ubuntu)
# DEPLOY_SSH_KEY       = private SSH key (contents of ~/.ssh/id_rsa)
# DEPLOY_PORT          = SSH port (default 22)
# NEXT_PUBLIC_API_URL  = public API URL for production build
# JWT_SECRET           = JWT signing secret (same as above)

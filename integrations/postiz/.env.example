# Postiz configuration — copy to .env and fill in values
# NEVER commit this file with real values to git

POSTIZ_URL=http://localhost:5000
POSTIZ_FRONTEND_URL=http://localhost:5000
POSTIZ_JWT_SECRET=CHANGE_ME_minimum_32_chars_random_string
POSTIZ_SECRET=CHANGE_ME_backend_api_secret

POSTGRES_PASSWORD=CHANGE_ME_postgres_password

# Social platform OAuth keys (create apps on each developer portal)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Telegram (custom connector — not Postiz)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# WhatsApp Business API (custom connector)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Google Business Profile (custom connector)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Postiz — Social Publishing Provider Configuration
# Variable names taken from Postiz official docs (github.com/gitroomhq/postiz-app)
#
# RULES:
#   1. APP_ID / CLIENT_ID  = safe to store here (application identity, not secret)
#   2. APP_SECRET / CLIENT_SECRET = treat as a password — use OpenBao in production
#   3. ACCESS TOKENS / REFRESH TOKENS = NEVER put here — generated by OAuth, stored by Postiz
#   4. YOUR PASSWORDS = NEVER put here
#
# After setting values, restart Postiz:
#   docker compose restart postiz
# Then connect each account via Postiz UI → Settings → Social Accounts → Connect
# ─────────────────────────────────────────────────────────────────────────────

# ── Postiz Core ──────────────────────────────────────────────────────────────
POSTIZ_CLIENT_URL=http://localhost:3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postiz:CHANGE_ME@localhost:5432/postiz
REDIS_URL=redis://localhost:6379
JWT_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads
NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ── 1. Facebook Pages ─────────────────────────────────────────────────────────
# Developer portal: https://developers.facebook.com
# App type: Business → select "Facebook Login for Business"
# Products needed: Facebook Login, Instagram Graph API
# Permissions: pages_manage_posts, pages_read_engagement, instagram_content_publish
# Redirect URI: http://localhost:3000/api/socials/facebook/callback
FACEBOOK_APP_ID=<your_facebook_app_id>
FACEBOOK_APP_SECRET=<stored_in_openbao_slp-portal/facebook>

# ── 2. Instagram (uses same Facebook app) ────────────────────────────────────
# Same app as Facebook. Add "Instagram Graph API" product.
# Account type: Instagram Business Account linked to a Facebook Page
# Permissions: instagram_content_publish, instagram_basic, pages_show_list
# No extra env vars — uses FACEBOOK_APP_ID and FACEBOOK_APP_SECRET above

# ── 3. LinkedIn ───────────────────────────────────────────────────────────────
# Developer portal: https://www.linkedin.com/developers
# App type: Sign In with LinkedIn using OpenID Connect
# Products: Share on LinkedIn, Sign In with LinkedIn
# Permissions: w_member_social, r_basicprofile
# NOTE: Marketing API access requires explicit LinkedIn approval (not instant)
# Redirect URI: http://localhost:3000/api/socials/linkedin/callback
LINKEDIN_CLIENT_ID=<your_linkedin_client_id>
LINKEDIN_CLIENT_SECRET=<stored_in_openbao_slp-portal/linkedin>

# ── 4. X (Twitter) ───────────────────────────────────────────────────────────
# Developer portal: https://developer.twitter.com/en/portal/dashboard
# App type: Create a Project + App
# Auth: OAuth 2.0 with PKCE, User Authentication Settings enabled
# Scopes: tweet.read tweet.write users.read offline.access
# Redirect URI: http://localhost:3000/api/socials/x/callback
# NOTE: Verify current API access tier at developer.twitter.com — plans change
X_CLIENT_ID=<your_x_client_id>
X_CLIENT_SECRET=<stored_in_openbao_slp-portal/x>

# ── 5. TikTok ─────────────────────────────────────────────────────────────────
# Developer portal: https://developers.tiktok.com
# Product: Content Posting API (requires app review — not instant)
# Scopes: video.upload, video.publish
# Redirect URI: http://localhost:3000/api/socials/tiktok/callback
TIKTOK_CLIENT_ID=<your_tiktok_client_key>
TIKTOK_CLIENT_SECRET=<stored_in_openbao_slp-portal/tiktok>

# ── 6. YouTube (Google Cloud) ─────────────────────────────────────────────────
# Developer portal: https://console.cloud.google.com
# Steps: New project → Enable "YouTube Data API v3" → OAuth 2.0 credentials
# Scopes: https://www.googleapis.com/auth/youtube.upload
#         https://www.googleapis.com/auth/youtube.readonly
# Redirect URI: http://localhost:3000/api/socials/youtube/callback
YOUTUBE_CLIENT_ID=<your_google_oauth_client_id>
YOUTUBE_CLIENT_SECRET=<stored_in_openbao_slp-portal/youtube>

# ── 7. Pinterest ──────────────────────────────────────────────────────────────
# Developer portal: https://developers.pinterest.com
# Permissions: boards:read, boards:write, pins:read, pins:write
# Redirect URI: http://localhost:3000/api/socials/pinterest/callback
PINTEREST_CLIENT_ID=<your_pinterest_app_id>
PINTEREST_CLIENT_SECRET=<stored_in_openbao_slp-portal/pinterest>

# ── 8. Reddit ─────────────────────────────────────────────────────────────────
# Developer portal: https://www.reddit.com/prefs/apps
# App type: "web app" (not "installed app")
# Scopes: submit, read, identity
# Redirect URI: http://localhost:3000/api/socials/reddit/callback
REDDIT_CLIENT_ID=<your_reddit_app_client_id>
REDDIT_CLIENT_SECRET=<stored_in_openbao_slp-portal/reddit>

# ── 9. Telegram ───────────────────────────────────────────────────────────────
# Setup: Open Telegram → search @BotFather → /newbot → follow prompts
# No developer portal signup required — just a Telegram account
# Token format: 1234567890:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Note: Bot can only post to channels/groups where it's an admin
TELEGRAM_BOT_TOKEN=<stored_in_openbao_slp-portal/telegram>

# ── 10. Discord ───────────────────────────────────────────────────────────────
# Developer portal: https://discord.com/developers/applications
# Create Application → Bot tab → Add Bot → copy token
# OR: use Webhook URL (Server Settings → Integrations → Webhooks)
# Bot permissions: Send Messages, Embed Links, Attach Files
DISCORD_CLIENT_ID=<your_discord_application_id>
DISCORD_CLIENT_SECRET=<stored_in_openbao_slp-portal/discord>
# Alternative (simpler): use webhook instead of OAuth
# DISCORD_WEBHOOK_URL=<stored_in_openbao_slp-portal/discord_webhook>

# ── 11. Threads ───────────────────────────────────────────────────────────────
# Uses Meta developer app — same platform as Facebook/Instagram
# Product: Threads API (add in same Facebook app)
# Permissions: threads_basic, threads_content_publish
THREADS_APP_ID=<same_as_FACEBOOK_APP_ID>
THREADS_APP_SECRET=<same_as_FACEBOOK_APP_SECRET>

# ── 12. Bluesky ───────────────────────────────────────────────────────────────
# No developer app required — uses App Password
# Settings → Privacy and Security → App Passwords → Add App Password
# Postiz stores HANDLE + APP_PASSWORD (not your main password)
BLUESKY_APP_PASSWORD=<stored_in_openbao_slp-portal/bluesky>
# BLUESKY_HANDLE is set per connected account in Postiz UI

# ── 13. Mastodon ──────────────────────────────────────────────────────────────
# Create app at: https://YOUR_INSTANCE/settings/applications/new
# Each instance is separate — no central developer portal
# Scopes: read write follow
MASTODON_CLIENT_ID=<your_mastodon_app_client_id>
MASTODON_CLIENT_SECRET=<stored_in_openbao_slp-portal/mastodon>
MASTODON_INSTANCE=<your_mastodon_instance_url>

{
  "realm": "slp",
  "displayName": "Soham Yoga Portal",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "roles": {
    "realm": [
      { "name": "student",          "description": "Enrolled yoga student" },
      { "name": "teacher",          "description": "Yoga teacher / instructor" },
      { "name": "reception",        "description": "Front desk staff" },
      { "name": "marketing",        "description": "Marketing team" },
      { "name": "finance",          "description": "Finance/accounting" },
      { "name": "manager",          "description": "Studio manager" },
      { "name": "admin",            "description": "Studio administrator" },
      { "name": "super_admin",      "description": "Super administrator" }
    ]
  },
  "clients": [
    {
      "clientId": "slp-portal",
      "name": "SLP Portal",
      "enabled": true,
      "publicClient": false,
      "redirectUris": [
        "http://localhost:3000/*",
        "https://*.sohamyoga.ca/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://*.sohamyoga.ca"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["openid", "profile", "email", "roles"],
      "optionalClientScopes": ["phone", "address"]
    },
    {
      "clientId": "slp-mcp",
      "name": "SLP MCP Gateway",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect",
      "description": "Machine-to-machine client for MCP tool calls"
    }
  ],
  "requiredCredentials": ["password"],
  "passwordPolicy": "length(10) and upperCase(1) and digits(1) and specialChars(1) and notUsername(undefined) and notEmail(undefined)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "smtpServer": {},
  "loginTheme": "keycloak",
  "accountTheme": "keycloak.v3",
  "adminTheme": "keycloak.v2",
  "eventsEnabled": true,
  "eventsExpiration": 2592000,
  "enabledEventTypes": [
    "LOGIN", "LOGIN_ERROR", "LOGOUT", "REGISTER",
    "UPDATE_PASSWORD", "UPDATE_PROFILE",
    "RESET_PASSWORD", "RESET_PASSWORD_ERROR",
    "SEND_VERIFY_EMAIL", "VERIFY_EMAIL",
    "REMOVE_TOTP", "UPDATE_TOTP"
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": true
}

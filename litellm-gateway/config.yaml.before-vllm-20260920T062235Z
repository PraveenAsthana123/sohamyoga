# LiteLLM Gateway config — real, minimal, scoped setup.
# Added 2026-09-08 per the audit's "start small" decision: prove LiteLLM
# can route to what's actually running (local Ollama, 3 real pulled models)
# before layering Semantic Router or a custom policy engine on top.
# Model names/tiers match ai-orchestrator-platform's existing OLLAMA_MODEL_*
# env vars (fast/code/strong) so this can later stand in for that portal's
# router.py without renaming anything downstream.
#
# CORRECTED 2026-09-08 (same day, later): api_base was originally
# 127.0.0.1:11434. That is the "older/smaller Ollama instance (10 models)"
# per ai-orchestrator-platform/backend/app/config.py's own comment --
# 11435 is "the full-catalog instance (39 models)" that app actually
# targets (OLLAMA_URL default), decision-logged 2026-09-02. Fixed to point
# at 11435 to match the real integration target. The 3 models pulled onto
# 11434 earlier this session were redundant -- 11435 already had all three
# (phi4-mini:latest, qwen2.5-coder:latest, qwen2.5:latest) the whole time.
#
# IMPORTANT: use `ollama_chat/`, not `ollama/`. Found live during setup:
# `ollama/` routes through LiteLLM's raw-completion translation, which sent
# an unformatted prompt to Ollama's legacy /api/generate endpoint -- the
# model then continued it as free text instead of following the instruction
# (tested: asked for one word, got ~5,300 tokens of unrelated fiction).
# `ollama_chat/` uses Ollama's real /api/chat endpoint with proper message
# formatting, verified correct: same prompt, same model, real "OK" back,
# 2 tokens. Confirmed against Ollama directly (curl /api/chat) before
# concluding LiteLLM's provider prefix was the actual bug, not the model.
model_list:
  - model_name: fast
    litellm_params:
      model: ollama_chat/phi4-mini:latest
      api_base: http://127.0.0.1:11435
      max_tokens: 1024

  - model_name: code
    litellm_params:
      model: ollama_chat/qwen2.5-coder:latest
      api_base: http://127.0.0.1:11435
      max_tokens: 1024

  - model_name: strong
    litellm_params:
      model: ollama_chat/qwen2.5:latest
      api_base: http://127.0.0.1:11435
      max_tokens: 1024

general_settings:
  # No master key set yet -- this is bound to 127.0.0.1 only (see the
  # systemd unit), matching this workspace's existing pattern of gating
  # exposure at the network/tunnel layer rather than app-layer auth for
  # single-operator local services. Revisit before any wider exposure.
  #
  # disable_spend_logs was true (spend/cost tracking off) -- flipped to
  # false 2026-09-08 after being asked directly whether this gateway
  # tracks cost. Local Ollama models have no real $ cost, but token/latency
  # spend records are still useful observability data, so leaving it on.
  disable_spend_logs: false

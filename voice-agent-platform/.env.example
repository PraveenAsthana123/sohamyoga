# Postgres (docker-compose.yml)
POSTGRES_DB=voiceagent
POSTGRES_USER=voiceagent
POSTGRES_PASSWORD=change-me-before-production
POSTGRES_PORT=5438

# Used by the Next.js app (src/lib/db.ts) to connect to the same database.
DATABASE_URL=postgresql://voiceagent:change-me-before-production@localhost:5438/voiceagent

# Session cookie signing secret (HMAC). Generate a real random value for
# anything beyond local development, e.g.: openssl rand -hex 32
SESSION_SECRET=dev-only-change-me

# Optional bootstrap admin account created by scripts/create-admin.ts if it
# does not already exist. Never commit real credentials here.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

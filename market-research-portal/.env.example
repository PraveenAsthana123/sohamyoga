# Copy to .env.local and fill in real values. Never commit real secrets.
MRP_PORT=8086

DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5437/market_research_portal

# Read-only role into sohamyoga's DB — must be GRANT SELECT only.
SOHAMYOGA_RO_DATABASE_URL=postgresql://sohamyoga_ro:PASSWORD@127.0.0.1:5437/sohamyoga

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL_FAST=phi4-mini:latest
OLLAMA_MODEL_CODE=qwen2.5-coder:latest
OLLAMA_MODEL_STRONG=qwen2.5:latest

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
SESSION_COOKIE_SECRET=generate-a-random-64-char-hex-string

# Optional production providers. Missing credentials keep jobs blocked.
HIGGSFIELD_API_KEY=
HIGGSFIELD_BASE_URL=
HIGGSFIELD_MODEL=
POSTIZ_PUBLIC_API_KEY=
POSTIZ_API_URL=http://127.0.0.1:15081
VOICE_PROVIDER=
VOICE_ACCOUNT_ID=
VOICE_AUTH_TOKEN=

# =============================================================================
# Sohamyoga — Enterprise Marketing Suite
# Environment Variables Reference
# Copy this file to .env.local and fill in your values.
# REQUIRED variables must be set for the app to start.
# OPTIONAL variables enable specific integrations/features.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# REQUIRED — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/sohamyoga

# OPTIONAL — Redis URL for caching/queuing
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Authentication (NextAuth.js)
# -----------------------------------------------------------------------------
# REQUIRED — Secret used to sign session tokens (min 32 chars)
NEXTAUTH_SECRET=your-secret-here-min-32-chars

# REQUIRED — Public URL of this app (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# App URLs (public + internal)
# -----------------------------------------------------------------------------
# REQUIRED — Base URL for this frontend app, used for absolute links
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OPTIONAL — Aliases for the same base URL used in different contexts
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# OPTIONAL — Internal service-to-service URL for the backend API (Docker network)
INTERNAL_API_URL=http://backend:5070

# OPTIONAL — AI orchestrator agent API
AGENT_API_URL=http://localhost:5070
AGENT_WEBHOOK_SECRET=your-agent-webhook-secret

# -----------------------------------------------------------------------------
# Ollama (Local AI — REQUIRED if using AI features)
# -----------------------------------------------------------------------------
# REQUIRED for AI features — Ollama server base URL
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_URL=http://localhost:11434

# OPTIONAL — Model names (defaults to llama3 if not set)
OLLAMA_MODEL=llama3
OLLAMA_MODEL_CODE=codellama
OLLAMA_MODEL_FAST=phi3
OLLAMA_MODEL_STRONG=llama3

# OPTIONAL — Timeout/keepalive tuning (milliseconds)
OLLAMA_DEADLINE_MS=30000
OLLAMA_FIRST_TOKEN_TIMEOUT_MS=10000
OLLAMA_IDLE_TIMEOUT_MS=60000
OLLAMA_KEEP_ALIVE=5m

# OPTIONAL — Public AI API URL exposed to the browser
NEXT_PUBLIC_AI_API_URL=http://localhost:5070

# -----------------------------------------------------------------------------
# OpenAI / LLM (cloud fallback)
# -----------------------------------------------------------------------------
# OPTIONAL — OpenAI API key (used if Ollama unavailable)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# OPTIONAL — Google Gemini API key
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Email / SMTP
# -----------------------------------------------------------------------------
# REQUIRED for email sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@yourdomain.com

# OPTIONAL — Gmail OAuth2 (alternative to SMTP password)
GMAIL_CLIENT_ID=your-gmail-oauth-client-id
GMAIL_CLIENT_SECRET=your-gmail-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token

# OPTIONAL — IMAP inbox polling
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com

# -----------------------------------------------------------------------------
# Stripe (Payments)
# -----------------------------------------------------------------------------
# REQUIRED for payment processing
STRIPE_SECRET_KEY=sk_test_...
# REQUIRED for frontend checkout
NEXT_PUBLIC_STRIPE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PK=pk_test_...

# -----------------------------------------------------------------------------
# Google OAuth / Google APIs
# -----------------------------------------------------------------------------
# REQUIRED for Google login
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# OPTIONAL — Google Ads API
GOOGLE_ADS_CLIENT_ID=your-google-ads-client-id
GOOGLE_ADS_CLIENT_SECRET=your-google-ads-client-secret
GOOGLE_ADS_CUSTOMER_ID=123-456-7890
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token

# OPTIONAL — Google Drive integration
GOOGLE_DRIVE_CLIENT_ID=your-drive-client-id
GOOGLE_DRIVE_CLIENT_SECRET=your-drive-client-secret
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google-drive

# OPTIONAL — Google Calendar
GOOGLE_CALENDAR_TOKEN=your-google-calendar-token

# -----------------------------------------------------------------------------
# GitHub OAuth / GitHub Integration
# -----------------------------------------------------------------------------
# OPTIONAL — GitHub OAuth app credentials
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github

# OPTIONAL — GitHub API token (for repo integrations)
GITHUB_TOKEN=ghp_...
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# OPTIONAL — GitLab webhook secret
GITLAB_WEBHOOK_SECRET=your-gitlab-webhook-secret

# -----------------------------------------------------------------------------
# Social Media — Meta (Facebook / Instagram)
# -----------------------------------------------------------------------------
# OPTIONAL — Facebook app and page credentials
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token
FACEBOOK_PAGE_ID=your-facebook-page-id
FACEBOOK_PAGE_TOKEN=your-facebook-page-token

# OPTIONAL — Meta Ads / Instagram
META_AD_ACCOUNT_ID=act_123456789
META_PAGE_ACCESS_TOKEN=your-meta-page-access-token
META_PAGE_ID=your-meta-page-id
META_IG_USER_ID=your-instagram-user-id
INSTAGRAM_ACCOUNT_ID=your-instagram-account-id

# OPTIONAL — Public Facebook/Instagram URLs for the site
NEXT_PUBLIC_FACEBOOK=https://facebook.com/yourpage
NEXT_PUBLIC_INSTAGRAM=https://instagram.com/yourhandle

# -----------------------------------------------------------------------------
# Social Media — LinkedIn
# -----------------------------------------------------------------------------
# OPTIONAL — LinkedIn OAuth app credentials
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_ACCESS_TOKEN=your-linkedin-access-token

# -----------------------------------------------------------------------------
# Social Media — Twitter / X
# -----------------------------------------------------------------------------
# OPTIONAL — Twitter Bearer token for read operations
TWITTER_BEARER_TOKEN=your-twitter-bearer-token

# -----------------------------------------------------------------------------
# Social Media — YouTube
# -----------------------------------------------------------------------------
# OPTIONAL — YouTube API credentials
YOUTUBE_API_KEY=your-youtube-api-key
YOUTUBE_CHANNEL_ID=your-channel-id
YOUTUBE_CLIENT_ID=your-youtube-oauth-client-id
YOUTUBE_CLIENT_SECRET=your-youtube-oauth-client-secret
YOUTUBE_REFRESH_TOKEN=your-youtube-refresh-token

# OPTIONAL — Public YouTube channel URL
NEXT_PUBLIC_YOUTUBE=https://youtube.com/@yourchannel

# -----------------------------------------------------------------------------
# Social Media — TikTok
# -----------------------------------------------------------------------------
# OPTIONAL — TikTok developer app credentials
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# -----------------------------------------------------------------------------
# Social Media — Pinterest
# -----------------------------------------------------------------------------
# OPTIONAL — Pinterest API access token
PINTEREST_ACCESS_TOKEN=your-pinterest-access-token

# -----------------------------------------------------------------------------
# Social Media — Telegram
# -----------------------------------------------------------------------------
# OPTIONAL — Telegram bot integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# -----------------------------------------------------------------------------
# WhatsApp / Twilio
# -----------------------------------------------------------------------------
# OPTIONAL — WhatsApp Business API (Meta)
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
NEXT_PUBLIC_WHATSAPP=+1234567890
NEXT_PUBLIC_WHATSAPP_ENABLED=false

# OPTIONAL — Twilio (SMS / WhatsApp fallback)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+15551234567
TWILIO_FROM_NUMBER=+15551234567

# -----------------------------------------------------------------------------
# Postiz (Social Scheduling)
# -----------------------------------------------------------------------------
# OPTIONAL — Postiz self-hosted social scheduling integration
POSTIZ_PUBLIC_API_URL=http://localhost:5000
POSTIZ_PUBLIC_API_BASE=http://localhost:5000
POSTIZ_PUBLIC_API_KEY=your-postiz-api-key
POSTIZ_CLIENT_URL=http://localhost:5000
POSTIZ_INTERNAL_URL=http://postiz:5000

# -----------------------------------------------------------------------------
# Novu (Notifications)
# -----------------------------------------------------------------------------
# OPTIONAL — Novu notification service
NOVU_API_KEY=your-novu-api-key
NOVU_BASE_URL=https://api.novu.co

# OPTIONAL — Notification throttle settings
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_MAX_NON_ESSENTIAL_PER_DAY=10

# -----------------------------------------------------------------------------
# Analytics — Matomo
# -----------------------------------------------------------------------------
# OPTIONAL — Matomo self-hosted analytics
MATOMO_BASE_URL=http://localhost:8080
MATOMO_SITE_ID=1
MATOMO_AUTH_TOKEN=your-matomo-auth-token

# -----------------------------------------------------------------------------
# Analytics — PostHog
# -----------------------------------------------------------------------------
# OPTIONAL — PostHog product analytics
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# -----------------------------------------------------------------------------
# Feature Flags — GrowthBook
# -----------------------------------------------------------------------------
# OPTIONAL — GrowthBook feature flags
NEXT_PUBLIC_GROWTHBOOK_KEY=your-growthbook-sdk-key

# -----------------------------------------------------------------------------
# CRM — Mautic
# -----------------------------------------------------------------------------
# OPTIONAL — Mautic self-hosted CRM
MAUTIC_URL=http://localhost:8081
MAUTIC_BASE_URL=http://localhost:8081
MAUTIC_USER=admin
MAUTIC_PASSWORD=your-mautic-password

# -----------------------------------------------------------------------------
# Scheduling / Booking — Cal.com
# -----------------------------------------------------------------------------
# OPTIONAL — Cal.com booking integration
CALCOM_API_KEY=your-calcom-api-key
CALCOM_EVENT_TYPE_ID=1
NEXT_PUBLIC_CALCOM_USERNAME=your-calcom-username

# -----------------------------------------------------------------------------
# Events — Eventbrite / Luma / Meetup
# -----------------------------------------------------------------------------
# OPTIONAL — Eventbrite API token
EVENTBRITE_TOKEN=your-eventbrite-token

# OPTIONAL — Luma event management
LUMA_API_KEY=your-luma-api-key
LUMA_CALENDAR_ID=your-luma-calendar-id

# OPTIONAL — Meetup API
MEETUP_API_KEY=your-meetup-api-key
MEETUP_GROUP_URLNAME=your-group-slug

# -----------------------------------------------------------------------------
# AI / Media Generation
# -----------------------------------------------------------------------------
# OPTIONAL — ElevenLabs text-to-speech
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# OPTIONAL — Sarvam AI (Indian language TTS/ASR)
SARVAM_API_KEY=your-sarvam-api-key

# OPTIONAL — SerpAPI (search scraping)
SERPAPI_KEY=your-serpapi-key

# OPTIONAL — Skyvern (browser automation agent)
SKYVERN_API_KEY=your-skyvern-api-key
SKYVERN_BASE_URL=http://localhost:8080
SKYVERN_UI_URL=http://localhost:8080

# -----------------------------------------------------------------------------
# Automation / Integration Platforms
# -----------------------------------------------------------------------------
# OPTIONAL — ActivePieces self-hosted automation
ACTIVEPIECES_URL=http://localhost:8080
ACTIVEPIECES_HEALTH_URL=http://localhost:8080/api/v1/health

# OPTIONAL — Nango OAuth integration platform
NANGO_BASE_URL=https://api.nango.dev
NANGO_SECRET_KEY=your-nango-secret-key

# OPTIONAL — Generic integration event webhook secret
INTEGRATION_EVENT_SECRET=your-integration-event-secret

# OPTIONAL — Patreon webhook secret
PATREON_WEBHOOK_SECRET=your-patreon-webhook-secret

# OPTIONAL — Medium integration token for cross-posting
MEDIUM_INTEGRATION_TOKEN=your-medium-integration-token

# OPTIONAL — Discord bot/webhook
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# -----------------------------------------------------------------------------
# Secrets Management — OpenBao (self-hosted Vault)
# -----------------------------------------------------------------------------
# OPTIONAL — OpenBao / HashiCorp Vault for secrets management
OPENBAO_ADDR=http://localhost:8200
OPENBAO_ROOT_TOKEN=your-openbao-root-token

# -----------------------------------------------------------------------------
# Push Notifications (Web Push / VAPID)
# -----------------------------------------------------------------------------
# REQUIRED for web push notifications
VAPID_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_SUBJECT=mailto:admin@yourdomain.com

# -----------------------------------------------------------------------------
# Keycloak (SSO / Enterprise Auth — optional alternative to NextAuth)
# -----------------------------------------------------------------------------
# OPTIONAL — Keycloak SSO integration
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_REALM=sohamyoga
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=sohamyoga-client

# -----------------------------------------------------------------------------
# Site / Business Identity (public)
# -----------------------------------------------------------------------------
# OPTIONAL — Displayed contact details and social URLs
NEXT_PUBLIC_DOMAIN=yourdomain.com
NEXT_PUBLIC_ADDRESS=123 Main Street, City, Country
NEXT_PUBLIC_PHONE=+1234567890
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
NEXT_PUBLIC_COMMUNITY=https://community.yourdomain.com

# OPTIONAL — Feature flags (boolean strings: "true" / "false")
NEXT_PUBLIC_PAYMENTS=true
NEXT_PUBLIC_POSE_DETECTION=false
NEXT_PUBLIC_AI_COACH=false

# -----------------------------------------------------------------------------
# Security Scan (CI / internal tooling)
# -----------------------------------------------------------------------------
# OPTIONAL — Used by internal security scan jobs only, not runtime
SECURITY_SCAN_FRONTEND_URL=http://localhost:3000
SECURITY_SCAN_REPO_ROOT=/workspace

# -----------------------------------------------------------------------------
# Media / File Storage
# -----------------------------------------------------------------------------
# OPTIONAL — Local folder watched by media ingestion jobs
WATCHED_FOLDER_PATH=/var/sohamyoga/media
